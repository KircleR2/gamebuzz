# Django Settings
DEBUG=False
SECRET_KEY=django-insecure-change-this-to-a-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (PostgreSQL recommended for production)
# Uncomment these lines when ready to use PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=gamebuzz
# DB_USER=postgres
# DB_PASSWORD=your-database-password
# DB_HOST=localhost
# DB_PORT=5432

# For SQLite (development/testing only)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Cobalt Payment Gateway
COBALT_HOST=https://cbotest.cobalt.tech
COBALT_CLIENT_ID=9edb0211-6402-408f-b891-51dfb469fc45
COBALT_CLIENT_SECRET=your-cobalt-secret-key-here

# CORS (add your production domain)
CORS_ALLOWED_ORIGINS=http://localhost:8000,https://yourdomain.com

# Security
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Public Base URL
PUBLIC_BASE_URL=http://localhost:8000
